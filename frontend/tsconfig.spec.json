/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@app/*": ["./src/app/*"],
      "@fluy/schema": ["../shared/schema/dist/index"],
      "@fluy/schema/*": ["../shared/schema/dist/*"],
      "@schema/*": ["../shared/schema/dist/*"]
    },
    "outDir": "./out-tsc/spec",
    "types": [
      "jasmine"
    ]
  },
  "files": [
    "src/test.ts",
    "src/polyfills.ts"
  ],
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}
