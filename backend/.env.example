NODE_ENV=development
PORT=3000
API_PUBLIC_URL=http://localhost:3000

# Postgres (usados pelo docker-compose e pelo backend)
POSTGRES_USER=fluy
POSTGRES_PASSWORD=fluy
POSTGRES_DB=fluy
POSTGRES_PORT=5432

DATABASE_URL=postgresql://fluy:fluy@localhost:5432/fluy

# Storage S3-compatible (Cloudflare R2 na implantacao inicial)
STORAGE_ENDPOINT=https://sua-conta.r2.cloudflarestorage.com
STORAGE_BUCKET=fluy-dev
STORAGE_ACCESS_KEY_ID=sua_access_key_id
STORAGE_SECRET_ACCESS_KEY=sua_secret_access_key
STORAGE_REGION=auto

# Clerk: copie a Secret Key da instância de desenvolvimento no Dashboard.
# Nunca use uma chave real neste arquivo; a Publishable Key fica no frontend.
CLERK_SECRET_KEY=sk_test_sua_chave_secreta
CLERK_AUTHORIZED_PARTIES=http://localhost:4200

# Autentica uma identidade local fixa sem usar token do Clerk. Só pode ser
# habilitada com NODE_ENV=development. O subject precisa existir em
# identidade_autenticacao no banco local e estar vinculado a um salão como dono.
DEV_AUTH_ENABLED=false
# DEV_AUTH_TOKEN=gere_um_segredo_com_ao_menos_32_caracteres
# DEV_AUTH_SUBJECT=user_do_banco_local

# Origens que podem chamar a API pelo browser
CORS_ORIGINS=http://localhost:4200

# Domínio-base dos subdomínios públicos dos salões.
TENANT_BASE_DOMAIN=localhost

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
